# tlgrm-update-proxy configuration
# Copy to .env and fill in required values.

# ---------- Network ----------
# TCP bind address (host:port).
LISTEN_ADDR=0.0.0.0:8080

# ---------- GitHub ----------
# GitHub owner/repo for releases.
GITHUB_REPO=CelestialTech/tlgrm

# Optional GitHub Personal Access Token.
# Without it: 60 req/hr.  With it: 5 000 req/hr.
# The proxy only makes ~1 req/hr, so this is optional.
# GITHUB_TOKEN=ghp_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# ---------- Cache ----------
# Directory for the on-disk metadata cache file.
CACHE_DIR=/data/cache

# Metadata (in-memory + disk) cache TTL in seconds.  Default: 1 hour.
CACHE_TTL_SECS=3600

# max-age sent to clients on metadata responses.  Default: 5 minutes.
METADATA_CLIENT_CACHE_SECS=300

# ---------- Cloudflare ----------
# Public-facing domain (used to construct CF purge URLs).
PUBLIC_DOMAIN=updates.71grm.site

# s-maxage on binary responses (CF edge caches binaries this long).
# Default: 7 days.
CF_EDGE_CACHE_SECS=604800

# max-age on binary responses (client HTTP cache).  Default: 1 day.
CLIENT_BINARY_CACHE_SECS=86400

# Cloudflare zone ID + API token for edge cache purge on release deletion.
# If unset, CF purge is silently skipped.
# CLOUDFLARE_ZONE_ID=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
# CLOUDFLARE_API_TOKEN=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# ---------- Webhook ----------
# HMAC-SHA256 secret for GitHub webhook signature verification.
# REQUIRED if you want /webhook/github to work.
# WEBHOOK_SECRET=your-webhook-secret-here

# ---------- Logging ----------
# Standard Rust log levels: error, warn, info, debug, trace.
RUST_LOG=info
